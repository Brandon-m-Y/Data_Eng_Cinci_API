title {label: "Cincinnati crash star schema (BigQuery dataset: crashes)", size: "40"}
[dim_date]
    *date_key {label:"INT64"}
    full_date {label:"DATE"}
    day_of_week {label:"INT64"}
    day_of_week_name {label:"STRING"}
    day_of_week_abbr {label:"STRING"}
    is_weekend {label:"BOOL"}
    day_of_month {label:"INT64"}
    week_of_year {label:"INT64"}
    month_number {label:"INT64"}
    month_name {label:"STRING"}
    year_month {label:"STRING"}
    quarter {label:"INT64"}
    year {label:"INT64"}
[dim_time]
    *time_key {label:"INT64"}
    time_of_day {label:"TIME"}
    hour_24 {label:"INT64"}
    hour_12 {label:"INT64"}
    am_pm {label:"STRING"}
    minute_of_hour {label:"INT64"}
    hour_label {label:"STRING"}
    time_of_day_band {label:"STRING"}
    is_rush_hour {label:"BOOL"}
    is_overnight {label:"BOOL"}
[dim_location]
    *location_key {label:"INT64"}
    location_nk {label:"STRING"}
    address {label:"STRING"}
    zip {label:"STRING"}
    community_council_neighborhood {label:"STRING"}
    cpd_neighborhood {label:"STRING"}
    sna_neighborhood {label:"STRING"}
    road_class_code {label:"STRING"}
    road_class_desc {label:"STRING"}
    crash_location_raw {label:"STRING"}
    crash_location {label:"STRING"}
    is_intersection {label:"BOOL"}
[dim_conditions]
    *conditions_key {label:"INT64"}
    conditions_nk {label:"STRING"}
    light_conditions_raw {label:"STRING"}
    light_conditions {label:"STRING"}
    is_dark {label:"BOOL"}
    road_conditions_raw {label:"STRING"}
    road_conditions {label:"STRING"}
    is_slick {label:"BOOL"}
    road_contour_raw {label:"STRING"}
    road_contour {label:"STRING"}
    is_curve {label:"BOOL"}
    is_grade {label:"BOOL"}
    road_surface_raw {label:"STRING"}
    road_surface {label:"STRING"}
    weather_raw {label:"STRING"}
    weather {label:"STRING"}
    is_adverse_weather {label:"BOOL"}
[dim_crash_type]
    *crash_type_key {label:"INT64"}
    crash_type_nk {label:"STRING"}
    manner_of_crash_raw {label:"STRING"}
    manner_of_crash {label:"STRING"}
    is_collision {label:"BOOL"}
    crash_severity_raw {label:"STRING"}
    crash_severity_id_raw {label:"STRING"}
    crash_severity {label:"STRING"}
    crash_severity_rank {label:"INT64"}
    is_injury_crash {label:"BOOL"}
    is_fatal_crash {label:"BOOL"}
    coding_era {label:"STRING"}
[dim_person_profile]
    *person_profile_key {label:"INT64"}
    person_profile_nk {label:"STRING"}
    type_of_person_raw {label:"STRING"}
    type_of_person {label:"STRING"}
    is_motorist {label:"BOOL"}
    unit_type_raw {label:"STRING"}
    unit_type {label:"STRING"}
    unit_category {label:"STRING"}
    gender_raw {label:"STRING"}
    gender {label:"STRING"}
    age_band {label:"STRING"}
    age_band_sort {label:"INT64"}
    injury_severity_raw {label:"STRING"}
    injury_severity {label:"STRING"}
    injury_severity_code {label:"STRING"}
    injury_severity_rank {label:"INT64"}
[fact_crash_person]
    crash_date_key {label:"INT64"}
    reported_date_key {label:"INT64"}
    crash_time_key {label:"INT64"}
    location_key {label:"INT64"}
    conditions_key {label:"INT64"}
    crash_type_key {label:"INT64"}
    person_profile_key {label:"INT64"}
    instanceid {label:"STRING"}
    localreportno {label:"STRING"}
    source_dataset {label:"STRING"}
    socrata_id {label:"STRING"}
    crash_date {label:"DATE"}
    crash_datetime {label:"DATETIME"}
    reporting_lag_hours {label:"FLOAT64"}
    latitude {label:"FLOAT64"}
    longitude {label:"FLOAT64"}
    distance_to_cbd_m {label:"FLOAT64"}
    person_count {label:"INT64"}
    is_injured {label:"INT64"}
    is_fatal {label:"INT64"}
    age {label:"INT64"}
    age_range {label:"STRING"}
    neighborhood {label:"STRING"}
    socrata_version {label:"STRING"}
    socrata_updated_at {label:"TIMESTAMP"}
    loaded_at {label:"TIMESTAMP"}
    crash_hash {label:"STRING"}
dim_location."location_key" 1--* fact_crash_person."location_key"
dim_time."time_key" 1--* fact_crash_person."crash_time_key"
dim_date."date_key" 1--* fact_crash_person."crash_date_key"
dim_conditions."conditions_key" 1--* fact_crash_person."conditions_key"
dim_date."date_key" 1--* fact_crash_person."reported_date_key"
dim_person_profile."person_profile_key" 1--* fact_crash_person."person_profile_key"
dim_crash_type."crash_type_key" 1--* fact_crash_person."crash_type_key"