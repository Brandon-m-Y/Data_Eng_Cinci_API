# Secrets. Every *.json: a service-account key under any name must never
# reach this public repo. The exception below is listed by exact path, not
# by pattern, so the blanket rule still catches everything else -- including
# a key that happens to live in deploy/.
.env
*.json
!deploy/alert_job_failed.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Local data extracts
data/
*.csv
*.parquet
